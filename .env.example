# Copy to .env, fill in, and restrict permissions: chmod 600 .env
# The daemon reads these only from the environment; there is no --password flag.

# sqlite (default) or postgres
J2208_DB_BACKEND=postgres

# PostgreSQL connection. Omit J2208_PG_HOST to use the libpq default Unix
# socket; set it to 127.0.0.1 for TCP (which requires a password here).
J2208_PG_HOST=127.0.0.1
J2208_PG_PORT=5432
J2208_PG_DATABASE=bob
J2208_PG_USER=bob
J2208_PG_PASSWORD=change-me
J2208_PG_SCHEMA=j2208
J2208_PG_SSLMODE=prefer

# Optional pool sizing and device identity.
J2208_PG_POOL_MIN=1
J2208_PG_POOL_MAX=4
J2208_DEVICE_ID=
